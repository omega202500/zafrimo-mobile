<?xml version='1.0' encoding='utf-8'?>
<widget id="it.zafrimo.app" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>ZAFrimo</name><description>Immobiliare e consulenza in Italia</description>
  <content src="index.html" />
  <allow-intent href="mailto:*" />
  <access origin="*" /><allow-navigation href="https://*/*" />
  <preference name="Orientation" value="portrait"/>
  <preference name="StatusBarOverlaysWebView" value="false" />
  <preference name="StatusBarBackgroundColor" value="#141c0b" />
  <preference name="StatusBarStyle" value="lightcontent" />
</widget>
